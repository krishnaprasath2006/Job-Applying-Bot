{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Job Assistant",
  "version": "2.0.0",
  "identifier": "com.krishnaprasath.jobassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Job Assistant",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first job analysis assistant.",
    "longDescription": "Desktop shell around the canonical AI Job Assistant: a verified candidate truth model, job intelligence, and human review. Every model runs locally and real application submission is disabled by design.",
    "license": "CC-BY-NC-SA-4.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
