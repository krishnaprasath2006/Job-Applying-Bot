# Copy this file to ".env" and fill in your own values.
# ".env" is already in .gitignore, so your real credentials stay on your machine only.
# Never commit the real .env file.
#
# The assistant reads the namespaced form below. Section fields use a double
# underscore: ASSISTANT_SAFETY__DRY_RUN=configures safety.dry_run.
# The flat DRY_RUN / LINKEDIN_* names at the bottom are the legacy bot's names;
# the assistant accepts both, so the two cannot disagree.

# ---------------------------------------------------------------------------
# Safety: these are the switches that matter. Leave them as written.
# ---------------------------------------------------------------------------
ASSISTANT_SAFETY__SAFE_MODE=true
ASSISTANT_SAFETY__DRY_RUN=true
ASSISTANT_SAFETY__REQUIRE_HUMAN_APPROVAL=true
ASSISTANT_SAFETY__ALLOW_BROWSER_NAVIGATION=false
ASSISTANT_SAFETY__ALLOW_FORM_FILLING=false
ASSISTANT_SAFETY__ALLOW_FILE_UPLOAD=false
ASSISTANT_SAFETY__ALLOW_FINAL_SUBMISSION=false
ASSISTANT_SAFETY__MAX_APPLICATIONS_PER_RUN=5
ASSISTANT_SAFETY__CONFIRM_BEFORE_EACH_APPLICATION=true
ASSISTANT_SAFETY__BLOCK_ON_CAPTCHA=true
ASSISTANT_SAFETY__BLOCK_ON_MFA=true
ASSISTANT_SAFETY__RECORD_SCREENSHOTS=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ASSISTANT_APPLICATION__NAME=AI Job Assistant
ASSISTANT_APPLICATION__CANDIDATE_ID=primary

# ---------------------------------------------------------------------------
# AI provider. The local Ollama provider needs no API key.
# ---------------------------------------------------------------------------
ASSISTANT_AI__PROVIDER=ollama
ASSISTANT_AI__MODEL=qwen2.5:7b
ASSISTANT_AI__BASE_URL=http://localhost:11434
ASSISTANT_AI__EMBEDDING_MODEL=
ASSISTANT_AI__TEMPERATURE=0.1
ASSISTANT_AI__TIMEOUT_SECONDS=60
ASSISTANT_AI__CONNECT_TIMEOUT_SECONDS=3
ASSISTANT_AI__MAX_RETRIES=0
ASSISTANT_AI__JSON_MODE=true
# Only for hosted providers. Leave empty for Ollama.
ASSISTANT_AI__API_KEY=

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
ASSISTANT_DATABASE__PATH=data/assistant.db
ASSISTANT_DATABASE__ECHO=false
ASSISTANT_DATABASE__BUSY_TIMEOUT_SECONDS=5
ASSISTANT_DATABASE__ENABLE_WAL=true
ASSISTANT_DATABASE__ENABLE_FOREIGN_KEYS=true

# ---------------------------------------------------------------------------
# Browser (unused while allow_browser_navigation is false)
# ---------------------------------------------------------------------------
ASSISTANT_BROWSER__BROWSER=edge
ASSISTANT_BROWSER__HEADLESS=false
ASSISTANT_BROWSER__PAGE_LOAD_TIMEOUT_SECONDS=45
ASSISTANT_BROWSER__DOWNLOAD_DIR=data/downloads

# ---------------------------------------------------------------------------
# Job search
# ---------------------------------------------------------------------------
# Comma separated in one value, e.g. ASSISTANT_JOB_SEARCH__KEYWORDS=python,ml
ASSISTANT_JOB_SEARCH__KEYWORDS=
ASSISTANT_JOB_SEARCH__LOCATIONS=
ASSISTANT_JOB_SEARCH__EXCLUDE_KEYWORDS=
ASSISTANT_JOB_SEARCH__REMOTE_ONLY=false
ASSISTANT_JOB_SEARCH__EASY_APPLY_ONLY=true
ASSISTANT_JOB_SEARCH__RESULTS_PER_PAGE=10
ASSISTANT_JOB_SEARCH__YEARS_OF_EXPERIENCE_MIN=0
ASSISTANT_JOB_SEARCH__COMPANY_BLACKLIST=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
ASSISTANT_LOGGING__LEVEL=INFO
ASSISTANT_LOGGING__FORMAT=json
ASSISTANT_LOGGING__TO_FILE=true
ASSISTANT_LOGGING__MAX_BYTES=5000000
ASSISTANT_LOGGING__BACKUP_COUNT=3
# Leave false: resume bodies are candidate private data.
ASSISTANT_LOGGING__LOG_RESUME_BODIES=false

# ---------------------------------------------------------------------------
# Legacy names read by linkedin.py. The assistant honours these too.
# ---------------------------------------------------------------------------
DRY_RUN=true
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_LINKEDIN_URL=
APPLICANT_PHONE=
